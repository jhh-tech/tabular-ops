<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file build: one TabularOps.exe that runs without the .NET runtime installed.
  Usage: dotnet publish src\TabularOps.Desktop -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF, AnalysisServices and SQLite ship native DLLs; bundle them into the exe too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming breaks WPF/TOM reflection; keep it off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
  </PropertyGroup>

  <!-- Referenced projects (TabularOps.Core) still emit .pdb files; keep them out of the release. -->
  <Target Name="ExcludePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
